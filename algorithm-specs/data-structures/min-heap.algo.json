{
  "id": "min-heap",
  "name": "Min Heap",
  "category": "data-structures",
  "description": "A complete binary tree where the value of each node is less than or equal to the values of its children, ensuring the minimum element is always at the root. The heap is typically stored as an array where for index i, the left child is at 2i+1, the right child is at 2i+2, and the parent is at floor((i-1)/2). Supports efficient insert (bubble-up) and extract-min (bubble-down) operations.",
  "complexity": {
    "time": {
      "insert": {
        "average": "O(log n)",
        "worst": "O(log n)"
      },
      "extractMin": {
        "average": "O(log n)",
        "worst": "O(log n)"
      },
      "peek": {
        "average": "O(1)",
        "worst": "O(1)"
      }
    },
    "space": "O(n)"
  },
  "pseudocode": [
    { "line": 0, "text": "procedure insert(heap, value)" },
    { "line": 1, "text": "  heap.append(value)" },
    { "line": 2, "text": "  i ← heap.size - 1" },
    { "line": 3, "text": "  while i > 0 and heap[i] < heap[parent(i)] do" },
    { "line": 4, "text": "    swap heap[i] and heap[parent(i)]" },
    { "line": 5, "text": "    i ← parent(i)" },
    { "line": 6, "text": "" },
    { "line": 7, "text": "procedure extractMin(heap)" },
    { "line": 8, "text": "  if heap is empty then return null" },
    { "line": 9, "text": "  min ← heap[0]" },
    { "line": 10, "text": "  heap[0] ← heap[heap.size - 1]" },
    { "line": 11, "text": "  heap.removeLast()" },
    { "line": 12, "text": "  bubbleDown(heap, 0)" },
    { "line": 13, "text": "  return min" },
    { "line": 14, "text": "" },
    { "line": 15, "text": "procedure bubbleDown(heap, i)" },
    { "line": 16, "text": "  smallest ← i" },
    { "line": 17, "text": "  left ← 2i + 1, right ← 2i + 2" },
    { "line": 18, "text": "  if left < heap.size and heap[left] < heap[smallest] then" },
    { "line": 19, "text": "    smallest ← left" },
    { "line": 20, "text": "  if right < heap.size and heap[right] < heap[smallest] then" },
    { "line": 21, "text": "    smallest ← right" },
    { "line": 22, "text": "  if smallest ≠ i then" },
    { "line": 23, "text": "    swap heap[i] and heap[smallest]" },
    { "line": 24, "text": "    bubbleDown(heap, smallest)" },
    { "line": 25, "text": "" },
    { "line": 26, "text": "procedure peek(heap)" },
    { "line": 27, "text": "  return heap[0]" }
  ],
  "stepTypes": [
    {
      "type": "compare",
      "description": "Comparing a node with its parent (bubble-up) or children (bubble-down)",
      "highlights": {
        "indices": ["i", "j"],
        "color": "comparing"
      }
    },
    {
      "type": "swap",
      "description": "Swapping two elements to maintain the heap property",
      "highlights": {
        "indices": ["i", "j"],
        "color": "swapping"
      }
    },
    {
      "type": "insert",
      "description": "Adding a new element at the end of the heap",
      "highlights": {
        "indices": ["i"],
        "color": "inserting"
      }
    },
    {
      "type": "remove",
      "description": "Removing the minimum element from the root",
      "highlights": {
        "indices": [0],
        "color": "removing"
      }
    },
    {
      "type": "highlight",
      "description": "Highlighting the current node being examined during bubble-up or bubble-down",
      "highlights": {
        "indices": ["i"],
        "color": "highlighted"
      }
    },
    {
      "type": "sorted",
      "description": "Element is in its correct heap position",
      "highlights": {
        "indices": ["i"],
        "color": "sorted"
      }
    }
  ],
  "inputSchema": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["insert", "extractMin", "peek"]
        },
        "value": {
          "type": "number",
          "description": "The value to insert (only required for insert operation)"
        }
      },
      "required": ["operation"]
    },
    "minLength": 1,
    "maxLength": 50,
    "default": [
      { "operation": "insert", "value": 15 },
      { "operation": "insert", "value": 10 },
      { "operation": "insert", "value": 20 },
      { "operation": "insert", "value": 5 },
      { "operation": "insert", "value": 8 },
      { "operation": "peek" },
      { "operation": "extractMin" },
      { "operation": "extractMin" }
    ]
  },
  "stateSchema": {
    "heap": {
      "type": "array",
      "items": { "type": "number" },
      "description": "The heap stored as an array"
    },
    "comparingIndices": { "type": "array", "items": { "type": "number" }, "maxItems": 2 },
    "swappingIndices": { "type": "array", "items": { "type": "number" }, "maxItems": 2 },
    "currentOperation": { "type": "string" },
    "extractedValue": { "type": "number", "description": "The value returned by the most recent extractMin" },
    "peekValue": { "type": "number", "description": "The value returned by the most recent peek" },
    "currentLine": { "type": "number" }
  },
  "testCases": [
    {
      "name": "Insert and bubble up",
      "input": [
        { "operation": "insert", "value": 20 },
        { "operation": "insert", "value": 15 },
        { "operation": "insert", "value": 10 },
        { "operation": "insert", "value": 5 },
        { "operation": "insert", "value": 1 }
      ],
      "description": "Each smaller insert triggers bubble-up swaps to maintain the min-heap property"
    },
    {
      "name": "Extract min and bubble down",
      "input": [
        { "operation": "insert", "value": 3 },
        { "operation": "insert", "value": 7 },
        { "operation": "insert", "value": 1 },
        { "operation": "insert", "value": 9 },
        { "operation": "insert", "value": 5 },
        { "operation": "extractMin" },
        { "operation": "extractMin" }
      ],
      "expectedExtractions": [1, 3],
      "description": "Extracting min twice returns elements in sorted order (1, 3) with bubble-down reheapification"
    },
    {
      "name": "Mixed operations with peek",
      "input": [
        { "operation": "insert", "value": 50 },
        { "operation": "insert", "value": 30 },
        { "operation": "peek" },
        { "operation": "insert", "value": 10 },
        { "operation": "peek" },
        { "operation": "extractMin" },
        { "operation": "peek" }
      ],
      "expectedPeeks": [30, 10, 30],
      "description": "Peek returns the current minimum without modifying the heap; minimum changes as elements are inserted and extracted"
    }
  ]
}
