{
  "id": "linked-list",
  "name": "Linked List",
  "category": "data-structures",
  "description": "A linear data structure where each element (node) contains a value and a reference (pointer) to the next node. Supports efficient insertion and deletion at the head, with sequential access for search and arbitrary position operations.",
  "complexity": {
    "time": {
      "insert": {
        "head": "O(1)",
        "tail": "O(1)"
      },
      "search": {
        "average": "O(n)",
        "worst": "O(n)"
      },
      "delete": {
        "average": "O(n)",
        "worst": "O(n)"
      }
    },
    "space": "O(n)"
  },
  "pseudocode": [
    { "line": 0, "text": "class Node" },
    { "line": 1, "text": "  value, next \u2190 null" },
    { "line": 2, "text": "" },
    { "line": 3, "text": "procedure insertHead(head, value)" },
    { "line": 4, "text": "  newNode \u2190 new Node(value)" },
    { "line": 5, "text": "  newNode.next \u2190 head" },
    { "line": 6, "text": "  head \u2190 newNode" },
    { "line": 7, "text": "  return head" },
    { "line": 8, "text": "" },
    { "line": 9, "text": "procedure insertTail(head, value)" },
    { "line": 10, "text": "  newNode \u2190 new Node(value)" },
    { "line": 11, "text": "  if head = null then return newNode" },
    { "line": 12, "text": "  current \u2190 head" },
    { "line": 13, "text": "  while current.next \u2260 null do" },
    { "line": 14, "text": "    current \u2190 current.next" },
    { "line": 15, "text": "  current.next \u2190 newNode" },
    { "line": 16, "text": "  return head" },
    { "line": 17, "text": "" },
    { "line": 18, "text": "procedure deleteNode(head, value)" },
    { "line": 19, "text": "  if head.value = value then return head.next" },
    { "line": 20, "text": "  current \u2190 head" },
    { "line": 21, "text": "  while current.next \u2260 null do" },
    { "line": 22, "text": "    if current.next.value = value then" },
    { "line": 23, "text": "      current.next \u2190 current.next.next" },
    { "line": 24, "text": "      return head" },
    { "line": 25, "text": "    current \u2190 current.next" },
    { "line": 26, "text": "  return head" },
    { "line": 27, "text": "" },
    { "line": 28, "text": "procedure search(head, target)" },
    { "line": 29, "text": "  current \u2190 head" },
    { "line": 30, "text": "  while current \u2260 null do" },
    { "line": 31, "text": "    if current.value = target then return FOUND" },
    { "line": 32, "text": "    current \u2190 current.next" },
    { "line": 33, "text": "  return NOT_FOUND" }
  ],
  "stepTypes": [
    {
      "type": "insert",
      "description": "Inserting a new node into the list",
