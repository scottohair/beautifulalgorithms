{
  "id": "selection-sort",
  "name": "Selection Sort",
  "category": "sorting",
  "description": "A simple comparison-based sorting algorithm that divides the input into a sorted and unsorted region, repeatedly finding the minimum element from the unsorted region and moving it to the end of the sorted region.",
  "complexity": {
    "time": {
      "best": "O(n²)",
      "average": "O(n²)",
      "worst": "O(n²)"
    },
    "space": "O(1)"
  },
  "stable": false,
  "inPlace": true,
  "pseudocode": [
    { "line": 0, "text": "procedure selectionSort(A: list)" },
    { "line": 1, "text": "  n ← length(A)" },
    { "line": 2, "text": "  for i ← 0 to n-2 do" },
    { "line": 3, "text": "    minIndex ← i" },
    { "line": 4, "text": "    for j ← i+1 to n-1 do" },
    { "line": 5, "text": "      if A[j] < A[minIndex] then" },
    { "line": 6, "text": "        minIndex ← j" },
    { "line": 7, "text": "    if minIndex ≠ i then" },
    { "line": 8, "text": "      swap(A[i], A[minIndex])" },
    { "line": 9, "text": "  return A" }
  ],
  "stepTypes": [
    {
      "type": "compare",
      "description": "Comparing current element with the current minimum",
      "highlights": {
        "indices": ["j", "minIndex"],
        "color": "comparing"
      }
    },
    {
      "type": "select",
      "description": "New minimum element found",
      "highlights": {
        "indices": ["j"],
        "color": "selecting"
      }
    },
    {
      "type": "swap",
      "description": "Swapping the minimum element with the first unsorted element",
      "highlights": {
        "indices": ["i", "minIndex"],
        "color": "swapping"
      }
    },
    {
      "type": "sorted",
      "description": "Element placed in its final sorted position",
      "highlights": {
        "indices": ["i"],
        "color": "sorted"
      }
    }
  ],
  "inputSchema": {
    "type": "array",
    "items": { "type": "number" },
    "minLength": 2,
    "maxLength": 50,
    "default": [64, 34, 25, 12, 22, 11, 90, 45, 78, 33]
  },
  "stateSchema": {
    "array": { "type": "array", "items": { "type": "number" } },
    "currentIndex": { "type": "number" },
    "minIndex": { "type": "number" },
    "comparingIndices": { "type": "array", "items": { "type": "number" }, "maxItems": 2 },
    "swappingIndices": { "type": "array", "items": { "type": "number" }, "maxItems": 2 },
    "sortedIndices": { "type": "array", "items": { "type": "number" } },
    "currentLine": { "type": "number" }
  },
  "testCases": [
    {
      "name": "Already sorted",
      "input": [1, 2, 3, 4, 5],
      "expected": [1, 2, 3, 4, 5],
      "expectedStepCount": 14
    },
    {
      "name": "Reverse sorted",
      "input": [5, 4, 3, 2, 1],
      "expected": [1, 2, 3, 4, 5],
      "expectedStepCount": 14
    },
    {
      "name": "Single swap needed",
      "input": [2, 1],
      "expected": [1, 2],
      "expectedStepCount": 2
    },
    {
      "name": "With duplicates",
      "input": [3, 1, 4, 1, 5],
      "expected": [1, 1, 3, 4, 5],
      "expectedStepCount": 14
    },
    {
      "name": "Default input",
      "input": [64, 34, 25, 12, 22, 11, 90, 45, 78, 33],
      "expected": [11, 12, 22, 25, 33, 34, 45, 64, 78, 90]
    }
  ]
}
