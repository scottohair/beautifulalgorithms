{
  "id": "quick-sort",
  "name": "Quick Sort",
  "category": "sorting",
  "description": "An efficient, in-place, divide-and-conquer sorting algorithm that selects a pivot element, partitions the array around it so that smaller elements are on the left and larger on the right, then recursively sorts the sub-arrays.",
  "complexity": {
    "time": {
      "best": "O(n log n)",
      "average": "O(n log n)",
      "worst": "O(n\u00b2)"
    },
    "space": "O(log n)"
  },
  "stable": false,
  "inPlace": true,
  "pseudocode": [
    { "line": 0, "text": "procedure quickSort(A: list, low, high)" },
    { "line": 1, "text": "  if low < high then" },
    { "line": 2, "text": "    p \u2190 partition(A, low, high)" },
    { "line": 3, "text": "    quickSort(A, low, p - 1)" },
    { "line": 4, "text": "    quickSort(A, p + 1, high)" },
    { "line": 5, "text": "" },
    { "line": 6, "text": "procedure partition(A, low, high)" },
    { "line": 7, "text": "  pivot \u2190 A[high]" },
    { "line": 8, "text": "  i \u2190 low - 1" },
    { "line": 9, "text": "  for j \u2190 low to high - 1 do" },
    { "line": 10, "text": "    if A[j] \u2264 pivot then" },
    { "line": 11, "text": "      i \u2190 i + 1" },
    { "line": 12, "text": "      swap(A[i], A[j])" },
    { "line": 13, "text": "  swap(A[i+1], A[high])" },
    { "line": 14, "text": "  return i + 1" }
  ],
  "stepTypes": [
    {
      "type": "compare",
      "description": "Comparing an element with the pivot value",
      "highlights": {
        "indices": ["j", "pivot"],
        "color": "comparing"
      }
    },
    {
      "type": "swap",
      "description": "Swapping two elements during partitioning",
      "highlights": {
        "indices": ["i", "j"],
        "color": "swapping"
      }
    },
    {
      "type": "pivot",
      "description": "Selecting the pivot element",
      "highlights": {
        "indices": ["high"],
        "color": "pivot"
      }
    },
    {
      "type": "partition",
      "description": "Pivot placed in its final sorted position after partitioning",
      "highlights": {
        "indices": ["pivotIndex"],
        "color": "partitioned"
      }
    },
    {
      "type": "sorted",
      "description": "Element is in its final sorted position",
      "highlights": {
        "indices": ["i"],
        "color": "sorted"
      }
    }
  ],
  "inputSchema": {
    "type": "array",
    "items": { "type": "number" },
    "minLength": 2,
    "maxLength": 50,
    "default": [64, 34, 25, 12, 22, 11, 90, 45, 78, 33]
  },
  "stateSchema": {
    "array": { "type": "array", "items": { "type": "number" } },
    "comparingIndices": { "type": "array", "items": { "type": "number" }, "maxItems": 2 },
    "swappingIndices": { "type": "array", "items": { "type": "number" }, "maxItems": 2 },
    "pivotIndex": { "type": "number" },
    "partitionIndex": { "type": "number" },
    "sortedIndices": { "type": "array", "items": { "type": "number" } },
    "currentLine": { "type": "number" }
  },
  "testCases": [
    {
      "name": "Empty array",
      "input": [],
      "expected": [],
      "expectedStepCount": 0
    },
    {
      "name": "Single element",
      "input": [42],
      "expected": [42],
      "expectedStepCount": 0
    },
    {
      "name": "Already sorted",
      "input": [1, 2, 3, 4, 5],
      "expected": [1, 2, 3, 4, 5]
    },
    {
      "name": "Reverse sorted",
      "input": [5, 4, 3, 2, 1],
      "expected": [1, 2, 3, 4, 5]
    },
    {
      "name": "Default input",
      "input": [64, 34, 25, 12, 22, 11, 90, 45, 78, 33],
      "expected": [11, 12, 22, 25, 33, 34, 45, 64, 78, 90]
    }
  ]
}
